#!/bin/sh -e

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

# Parse --host argument
HOST=""
OTHER_ARGS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --host=*) HOST="${1#*=}"; shift ;;
    --host)   HOST="$2"; shift 2 ;;
    *)        OTHER_ARGS="$OTHER_ARGS $1"; shift ;;
  esac
done

# Detect architecture
case "$(uname -m)" in
  x86_64)        ARCH="x86_64" ;;
  arm64|aarch64) ARCH="aarch64" ;;
  *)
    printf "%bUnsupported architecture: %s%b\n" "$RED" "$(uname -m)" "$NC"
    exit 1
    ;;
esac

OS="$(uname -s)"

if [ "$OS" = "Darwin" ]; then
  FLAKE_TARGET="${HOST:-${ARCH}-darwin}"
  export NIXPKGS_ALLOW_UNFREE=1

  printf "%bSwitching to new generation (%s)...%b\n" "$YELLOW" "$FLAKE_TARGET" "$NC"
  nh darwin switch . --hostname "$FLAKE_TARGET" --no-nom -- $OTHER_ARGS

elif [ "$OS" = "Linux" ]; then
  if grep -qi microsoft /proc/version 2>/dev/null || grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; then
    IS_WSL=1
  else
    IS_WSL=0
  fi

  if [ -n "$HOST" ]; then
    FLAKE_TARGET="$HOST"
  elif [ "$IS_WSL" = "1" ]; then
    FLAKE_TARGET="wsl"
  else
    FLAKE_TARGET="${ARCH}-linux"
  fi

  printf "%bSwitching to new generation (%s)...%b\n" "$YELLOW" "$FLAKE_TARGET" "$NC"
  sudo env SSH_AUTH_SOCK="$SSH_AUTH_SOCK" nh os switch . --hostname "$FLAKE_TARGET" -- $OTHER_ARGS

else
  printf "%bUnsupported OS: %s%b\n" "$RED" "$OS" "$NC"
  exit 1
fi

printf "%bSwitch to new generation complete!%b\n" "$GREEN" "$NC"

echo "✨ Switch successful!"

# Check if we are actually running inside iTerm2
if [ "$TERM_PROGRAM" = "iTerm.app" ]; then
  echo "🔄 iTerm2 detected. Restarting terminal..."
  ( nohup sh -c 'while pgrep -x iTerm2 > /dev/null 2>&1; do sleep 0.5; done; sleep 1; open -a iTerm' > /dev/null 2>&1 & )
  osascript -e 'tell application "iTerm" to quit'
else
  echo "ℹ️ Not running in iTerm2 (detected: ${TERM_PROGRAM:-unknown}). Skipping auto-restart."
  echo "👉 Please run 'exec zsh' or restart your current terminal manually."
fi
