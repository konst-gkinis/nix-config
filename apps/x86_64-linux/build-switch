#!/bin/sh -e

GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
NC='\033[0m'

# Parse arguments for an optional --host override (named flake target)
HOST=""
OTHER_ARGS=""
while [ $# -gt 0 ]; do
  case "$1" in
    --host=*)
      HOST="${1#*=}"
      shift
      ;;
    --host)
      HOST="$2"
      shift 2
      ;;
    *)
      OTHER_ARGS="$OTHER_ARGS $1"
      shift
      ;;
  esac
done

# Detect architecture
case "$(uname -m)" in
  x86_64) ARCH="x86_64" ;;
  arm64 | aarch64) ARCH="aarch64" ;;
  *)
    printf "%bUnsupported architecture: %s%b\n" "$RED" "$(uname -m)" "$NC"
    exit 1
    ;;
esac

OS="$(uname -s)"

if [ "$OS" = "Darwin" ]; then
  SYSTEM_TYPE="${HOST:-${ARCH}-darwin}"
  export NIXPKGS_ALLOW_UNFREE=1

  printf "%bStarting build for %s...%b\n" "$YELLOW" "$SYSTEM_TYPE" "$NC"
  nix --extra-experimental-features 'nix-command flakes' \
    build ".#darwinConfigurations.${SYSTEM_TYPE}.system" $OTHER_ARGS

  printf "%bSwitching to new generation...%b\n" "$YELLOW" "$NC"
  # See https://github.com/nix-darwin/nix-darwin/issues/1457 on why we need sudo
  sudo ./result/sw/bin/darwin-rebuild switch --flake ".#${SYSTEM_TYPE}" $OTHER_ARGS

  printf "%bCleaning up...%b\n" "$YELLOW" "$NC"
  unlink ./result
elif [ "$OS" = "Linux" ]; then
  # Detect WSL (Microsoft kernel string present in /proc/version or osrelease)
  if grep -qi microsoft /proc/version 2>/dev/null || grep -qi microsoft /proc/sys/kernel/osrelease 2>/dev/null; then
    IS_WSL=1
  else
    IS_WSL=0
  fi

  if [ -n "$HOST" ]; then
    FLAKE_TARGET="$HOST"
  elif [ "$IS_WSL" = "1" ]; then
    FLAKE_TARGET="wsl"
  else
    FLAKE_TARGET="${ARCH}-linux"
  fi

  printf "%bStarting build for %s...%b\n" "$YELLOW" "$FLAKE_TARGET" "$NC"
  # Prefer the activated system's nixos-rebuild; fall back to PATH (e.g. fresh installs)
  NIXOS_REBUILD_BIN="/run/current-system/sw/bin/nixos-rebuild"
  if [ ! -x "$NIXOS_REBUILD_BIN" ]; then
    NIXOS_REBUILD_BIN="$(command -v nixos-rebuild 2>/dev/null || true)"
  fi
  if [ -z "$NIXOS_REBUILD_BIN" ]; then
    printf "%bnixos-rebuild not found. Is this a NixOS system?%b\n" "$RED" "$NC"
    exit 1
  fi
  # Pass SSH from user to root so root can download secrets from private Github
  sudo SSH_AUTH_SOCK="$SSH_AUTH_SOCK" "$NIXOS_REBUILD_BIN" \
    switch --flake ".#${FLAKE_TARGET}" $OTHER_ARGS
else
  printf "%bUnsupported OS: %s%b\n" "$RED" "$OS" "$NC"
  exit 1
fi

printf "%bSwitch to new generation complete!%b\n" "$GREEN" "$NC"
