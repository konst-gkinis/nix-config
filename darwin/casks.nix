# Homebrew casks. A plain string is just installed; an attrset with
# `loginItem` (the bundle name under /Applications) is also started at login.
[
  "iterm2"
  "visual-studio-code"
  "brave-browser"
  "discord"
  "spotify"
  {
    name = "fluor";
    loginItem = "Fluor";
  }
  {
    name = "maccy";
    loginItem = "Maccy";
  }
  "caffeine"
  {
    name = "alt-tab";
    loginItem = "AltTab";
  }
  {
    name = "hiddenbar";
    loginItem = "Hidden Bar";
  }
  "linearmouse"
  { 
    name ="rectangle";
    loginItem = "Rectangle";
  }
  {
    name = "betterdisplay";
    loginItem = "BetterDisplay";
  }
  "tailscale-app"
  "crmne/tap/spotifast"
]
