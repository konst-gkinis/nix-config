#compdef slack-daemon
# slack-daemon (alias slackd). The commands and their descriptions are read from
# its own `help`, so one added to usage() in slack-daemon.sh completes without
# touching this file. None of them takes an argument.

local -a cmds
local line
for line in ${(f)"$(slack-daemon help 2>/dev/null)"}; do
  # "  name   description   (alias)"
  [[ $line =~ '^  ([a-z][a-z-]*) +(.*[^ ])' ]] || continue
  cmds+=("$match[1]:${match[2]%%  ##\(*\)}")
done

(( CURRENT == 2 )) && _describe -t commands 'slack-daemon command' cmds
