#compdef meeting-daemon
# meeting-daemon (alias md). The commands and their descriptions are read from
# its own `help`, so one added to usage() in meeting-daemon.sh completes without
# touching this file; only a command that takes an argument needs a case below.

local -a cmds
local line
for line in ${(f)"$(meeting-daemon help 2>/dev/null)"}; do
  # "  name [arg]   description   (alias)"; continuation lines are skipped,
  # and so is the comma that leads into one.
  [[ $line =~ '^  ([a-z][a-z-]*)( [[<][^]>]*[]>])? +(.*[^ ])' ]] || continue
  cmds+=("$match[1]:${${match[3]%%  ##\(*\)}%,}")
done

if (( CURRENT == 2 )); then
  _describe -t commands 'meeting-daemon command' cmds
elif (( CURRENT == 3 )); then
  case $words[2] in
    upcoming) _message 'hours ahead (default 12)' ;;
    join | meet-status) _message 'Google Meet link' ;;
    mute) _message 'title (or part) of an unanswered invite; see: meeting-daemon unanswered' ;;
    unmute)
      # Titles straight from the mute list (id<TAB>title), no Calendar lookup.
      local -a titles
      titles=(${(f)"$(cut -f2- "${XDG_STATE_HOME:-$HOME/.local/state}/meeting-daemon/muted-invites" 2>/dev/null)"})
      titles=(${titles//:/\\:})  # _describe splits on ':'
      _describe -t titles 'muted invite' titles
      ;;
  esac
fi
